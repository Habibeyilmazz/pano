# Production: a real Postgres. When unset, the app uses embedded PGlite in .data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/pano

# PGlite data directory for local dev (default .data/pglite; "memory://" for throwaway runs).
# PANO_DB=.data/pglite

# Time zone used for due dates, "today", week boundaries and timestamps.
# APP_TZ=Europe/Istanbul

# Session cookies are Secure by default. Only set to false for plain-HTTP setups you trust.
# COOKIE_SECURE=true
